                    echo '======================================'
                    echo 'SonarQube analysis SUCCESS'
                    echo '======================================'
                }

                failure {
                    echo '======================================'
                    echo 'SonarQube analysis FAILED'
                    echo '======================================'
                }
            }
        }


        // =========================================================
        // 4. SONARQUBE QUALITY GATE
        // =========================================================
        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }

