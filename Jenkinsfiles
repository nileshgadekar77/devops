pipeline {

    agent any

    environment {
        DOCKER_USERNAME = 'nileshgadekar'

        INVENTORY_IMAGE = "${DOCKER_USERNAME}/inventry-service"
        ORDER_IMAGE     = "${DOCKER_USERNAME}/order-service"
        PAYMENT_IMAGE   = "${DOCKER_USERNAME}/payment-service"
    }

    stages {

        // =========================================================
        // 1. CHECKOUT SOURCE CODE
        // =========================================================
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/nileshgadekar77/devops.git'
            }

            post {
                success {
                    echo 'Git checkout SUCCESS'
                }

                failure {
                    echo 'Git checkout FAILED'
                }
            }
        }


        // =========================================================
        // 2. BUILD & TEST MICROSERVICES
        // =========================================================
        stage('Build & Test') {

            parallel {

                stage('Inventory') {
                    steps {
                        dir('inventry-service') {
                            sh 'chmod +x mvnw'
                            sh './mvnw clean package'
                        }
                    }

                    post {
                        success {
                            echo 'Inventory build and test SUCCESS'
                        }

                        failure {
                            echo 'Inventory build and test FAILED'
                        }
                    }
                }


                stage('Order') {
                    steps {
                        dir('order-service') {
                            sh 'chmod +x mvnw'
                            sh './mvnw clean package'
                        }
                    }

                    post {
                        success {
                            echo 'Order build and test SUCCESS'
                        }

                        failure {
                            echo 'Order build and test FAILED'
                        }
                    }
                }


                stage('Payment') {
                    steps {
                        dir('payment-service') {
                            sh 'chmod +x mvnw'
                            sh './mvnw clean package'
                        }
                    }

                    post {
                        success {
                            echo 'Payment build and test SUCCESS'
                        }

                        failure {
                            echo 'Payment build and test FAILED'
                        }
                    }
                }
            }

            post {
                success {
                    echo '======================================'
                    echo 'All microservices build and test SUCCESS'
                    echo '======================================'
                }

                failure {
                    echo '======================================'
                    echo 'One or more microservices FAILED'
                    echo '======================================'
                }
            }
        }


        // =========================================================
        // 3. SONARQUBE ANALYSIS
        // =========================================================
        
        /*
        stage('SonarQube Analysis') {
            parallel {

                stage('Inventory SonarQube') {
                    steps {
